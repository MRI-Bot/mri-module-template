{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist"
  },
  "include": ["src", "index.ts"],
  // Specs são type-checados pelo ts-jest (tsconfig.test.json, com types jest) no
  // `test`/`test:coverage`. Excluí-los do `typecheck` (tsc --noEmit) evita o erro
  // "Cannot find name 'describe'/'expect'" — o tsc base não auto-inclui @types/jest.
  "exclude": ["**/*.spec.ts"]
}
